# .env.prod 템플릿 (커밋용) — cp .env.example .env.prod 후 CHANGE_ME 교체
APP_ENV=prod
BIND_HOST=127.0.0.1
API_PORT=8000
DB_ENGINE=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME@db:5432/app
# PostgreSQL 세션 상한 ms (0 = 끔, D22-①) — 문장·잠금 대기. idle-in-transaction 은 스트림 요청 때문에 기본 끔
DB_STATEMENT_TIMEOUT_MS=120000
DB_LOCK_TIMEOUT_MS=15000
DB_IDLE_TX_TIMEOUT_MS=0
# 주체별 동시 모델 요청 상한 (0 = 끔, D22-③) — 큰 요청을 동시에 열어 팀 예산 예약을 잠그지 않게
MODEL_MAX_INFLIGHT_PER_SUBJECT=32

# ── Identity (Epic 2) — 내장 IdP issuer = PUBLIC_BASE_URL/idp. 키는 Secret Manager 로 주입 권장(CHANGE_ME=자동 생성)
# 운영 도메인(https://…)으로 교체 — 비시크릿, 리허설 기본값
PUBLIC_BASE_URL=http://127.0.0.1:8000
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
SIGNING_KEY_PEM=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
# 키 회전(env 주입일 때) — 직전 키 (선택, D21-③). 암호화 이전 키는 재암호화 뒤 비운다. 서명 이전 키는 백업·보고서 서명 검증에
# 계속 쓰이므로 SIGNING_KEY_PREVIOUS_UNTIL 로 토큰 검증만 끝내고 남겨 둔다 (65th)
SIGNING_KEY_PEM_PREVIOUS=
ENCRYPTION_KEY_PREVIOUS=
# 2단계 회전(env, D22-②) — 다음 키를 먼저 배포(검증·복호화만) → 현재 키로 올림. 이전 서명 키 토큰 검증 끝(ISO 8601)·폐기 kid(쉼표)
SIGNING_KEY_PEM_NEXT=
ENCRYPTION_KEY_NEXT=
SIGNING_KEY_PREVIOUS_UNTIL=
SIGNING_REVOKED_KIDS=
ACCESS_TOKEN_TTL=3600
# uvicorn 워커 수 (runtime 이미지 · SCR-B05 replicas 표시)
UVICORN_WORKERS=2
# 업데이트 계획 (SCR-L04) — 대상 버전(비움 = 현재) · 이미지 서명 검증 cosign 공개키(PEM/경로, 비움 = 미설정)
ANX_TARGET_VERSION=
COSIGN_PUBLIC_KEY=

# ── Gateway (Epic 4) — 레이트리밋 백엔드 memory|redis(Valkey), 정책 엔진 builtin|opa
RATE_LIMIT_BACKEND=redis
VALKEY_URL=redis://valkey:6379/0
POLICY_ENGINE=builtin
OPA_URL=http://opa:8181

# ── MCP (Epic 6) — 참조 서버 주소·IdP 내부 주소는 compose environment 가 지정. stdio 허용 명령(쉼표, 비우면 금지)
MCP_REFRESH_ON_START_S=90
MCP_HEALTH_INTERVAL_S=60
MCP_STDIO_ALLOWED_COMMANDS=

# ── A2A (Epic 7) — 장기 Task 감시 주기(초, 0=끔). 데모 에이전트 주소·게이트웨이 내부 주소는 compose environment 가 지정
A2A_WATCH_INTERVAL_S=5

# ── Observe (Epic 9) — OTLP 외부 Collector(선택, 예: http://otel-collector:4318), 토큰은 주입 권장(CHANGE_ME=자동/비활성)
OTLP_ENDPOINT=
OTLP_INGEST_TOKEN=CHANGE_ME
METRICS_TOKEN=CHANGE_ME
SPAN_PROCESSOR=batch
LOG_LEVEL=INFO

# ── 독립 실행 (Epic 10) — 참조 MCP 서버·데모 A2A 는 compose 프로파일 demo. 셸에서 COMPOSE_PROFILES= 로 끄기
COMPOSE_PROFILES=demo

# 콘솔 SPA 개발 서버(vite, COMPOSE_PROFILES 에 web 포함 시) 게시 포트 — prod 는 api 가 dist 를 서빙
WEB_PORT=5173

# A2A gRPC 바인딩 (D16-②) — a2a-grpc 서비스 호스트 게시 포트 · 카드에 광고할 host:port(비우면 GRPC 인터페이스 미광고)
A2A_GRPC_PORT=8851
A2A_GRPC_PUBLIC_URL=127.0.0.1:8851
# gRPC 수신 TLS (선택) — 둘 다 있으면 TLS, 비우면 평문(앞단 TLS 종료). 카드 주소는 grpcs:// 로 광고
A2A_GRPC_TLS_CERT=
A2A_GRPC_TLS_KEY=

# 데모 A2A 에이전트 워크로드 시크릿 — 비우면 api 가 data_dir/workloads 에 생성(compose 공유 볼륨). Helm 은 Secret 으로 주입
A2A_DEMO_CLIENT_SECRET=

# MCP 서버의 sampling·elicitation 요청 동의 대기(초) — 무응답 시 자동 거부 (SCR-C08)
MCP_CONSENT_TIMEOUT_S=60

# 예약 작업 주기(초, 0=끔) — 경보 규칙 평가·실행 복구(워커 간 리스 1개만 수행) · 보존 기간 파기 점검 주기
SCHEDULER_INTERVAL_S=60
RETENTION_INTERVAL_S=3600
# 실행 생존 신호가 이 시간(초) 넘게 없으면 다른 워커가 이어서 실행 (재시작·다중 복제 복구)
RUN_STALE_S=90
# 원격 A2A 에이전트가 working 으로 답하면 상태를 조회하며 기다리는 최대 시간(초)
A2A_REMOTE_WAIT_S=120
# 채팅 첨부 최대 크기(MB)
ATTACHMENT_MAX_MB=20
